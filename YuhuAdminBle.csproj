<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!--
      net8.0-windows10.0.19041.0 gives access to the WinRT BLE APIs
      (Windows.Devices.Bluetooth.*). 10.0.19041 = Windows 10 2004; adjust the
      TargetFramework down to your installed SDK if needed (min 10.0.17763.0).
    -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>YuhuAdminBle</AssemblyName>
    <RootNamespace>YuhuAdminBle</RootNamespace>
  </PropertyGroup>

  <!--
    The test project lives in ./tests with its own .csproj. Exclude it here so
    the app doesn't try to compile the Xunit-based test sources (which would
    fail — the app doesn't reference Xunit). The tests build/run on their own
    via `dotnet test` inside the tests folder.
  -->
  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
  </ItemGroup>

</Project>
