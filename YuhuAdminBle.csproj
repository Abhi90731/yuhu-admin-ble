<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!--
      net8.0-windows10.0.19041.0 gives access to the WinRT BLE APIs
      (Windows.Devices.Bluetooth.*). 10.0.19041 = Windows 10 2004; adjust the
      TargetFramework down to your installed SDK if needed (min 10.0.17763.0).
    -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>YuhuAdminBle</AssemblyName>
    <RootNamespace>YuhuAdminBle</RootNamespace>
  </PropertyGroup>

</Project>
